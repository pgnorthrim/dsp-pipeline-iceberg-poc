        <mxCell id="team" value="&lt;b&gt;Existing team systems&lt;/b&gt; (not touched by the POC)" style="rounded=1;arcSize=6;dashed=1;html=1;fillColor=none;strokeColor=#879196;fontColor=#545B64;fontSize=11;align=center;spacingLeft=8;spacingRight=6;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="1580" y="360" width="270" height="470" as="geometry" /></mxCell>
