        <mxCell id="enrich" value="&lt;b&gt;Enrichment factory endpoint&lt;/b&gt; (Cillian)&lt;br&gt;POC: pass-through stub" style="rounded=1;arcSize=6;dashed=1;html=1;fillColor=#F2F3F3;strokeColor=#879196;fontColor=#545B64;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="1600" y="650" width="230" height="60" as="geometry" /></mxCell>
        <mxCell id="prodnote" value="No production buckets, l-prod or the real manifest location are written." style="rounded=1;arcSize=6;dashed=1;html=1;fillColor=#F2F3F3;strokeColor=#879196;fontColor=#545B64;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="1600" y="730" width="230" height="60" as="geometry" /></mxCell>
        <mxCell id="decided" value="&lt;b&gt;Decided (Paul, 10/27-10/28)&lt;/b&gt;&lt;br&gt;• One transform, two writers: A first, B second; nothing on A&#x27;s path reads B&lt;br&gt;• POC owns two output buckets: Parquet (S3) + Iceberg (S3 Tables table bucket)&lt;br&gt;• CheckLock = small zip Lambda, Step Functions API only, no S3&lt;br&gt;• Id history = ledger on the A side; window is config, default full history&lt;br&gt;• 6 output files per hour, one per publisher (6 vs 3: confirm with Jesse)&lt;br&gt;• Lake holds events only; quarantine stays in the team format&lt;br&gt;• Done = all output files exist + manifest; no separate job state" style="rounded=1;arcSize=6;dashed=0;html=1;fillColor=#EEF7EE;strokeColor=#7AA116;fontColor=#232F3E;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="260" y="1030" width="440" height="200" as="geometry" /></mxCell>
        <mxCell id="open" value="&lt;b&gt;Open / proposed&lt;/b&gt;&lt;br&gt;• Parallel hours: id check once per batch, or concurrency 1 for that step&lt;br&gt;• Lambda vs Fargate (Phase 0 measures the largest hour, target &amp;lt; 5 min)&lt;br&gt;• Iceberg layout: one table, publisher + day partitions&lt;br&gt;• Known gap: FindWork checks only the Parquet bucket, so a failed Writer B hour is not retried&lt;br&gt;• Jesse: archive window (Q-A), Redshift key retention (Q-B), O1, O2, reject threshold, Python Lambda OK, DTE-147" style="rounded=1;arcSize=6;dashed=0;html=1;fillColor=#FDF3E7;strokeColor=#ED7100;fontColor=#232F3E;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="720" y="1030" width="440" height="200" as="geometry" /></mxCell>
        <mxCell id="notpoc" value="&lt;b&gt;Not in Monday&#x27;s POC&lt;/b&gt;&lt;br&gt;Node heartbeat change · real enrichment · full backfill (1 week only) · monthly ledger roll-up (by 11/07) · whole-file reject threshold · NPI checks, bot filtering, restatements (D8, D9, D11) · wider Iceberg lake" style="rounded=1;arcSize=6;dashed=1;html=1;fillColor=#F2F3F3;strokeColor=#879196;fontColor=#545B64;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="1180" y="1030" width="340" height="125" as="geometry" /></mxCell>
        <mxCell id="tags" value="&lt;b&gt;Tags&lt;/b&gt;: project=dsp-poc, owner=paul, plus the sandbox standard set (Environment, DataClassification, AutoShutdown, managed_by=terraform)" style="rounded=1;arcSize=6;dashed=1;html=1;fillColor=#F2F3F3;strokeColor=#879196;fontColor=#545B64;fontSize=10;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="1180" y="1170" width="340" height="60" as="geometry" /></mxCell>
        <mxCell id="e1" value="&lt;span style=&quot;display:inline-block;width:22px;height:22px;line-height:22px;border-radius:11px;background-color:#1A73E8;color:#FFFFFF;font-weight:bold;font-size:14px;text-align:center;&quot;&gt;1&lt;/span&gt; hourly" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#232F3E;strokeWidth=2;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="sched" target="start" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="189" /><mxPoint x="330" y="205" /></Array></mxGeometry></mxCell>
